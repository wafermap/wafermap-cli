{
  "name": "@wafermapxyz/cli",
  "version": "0.4.10",
  "description": "Wafermap for agents: an encrypted local wallet that pays x402 resources, discovers and pays third-party x402 services (USDG on Robinhood Chain; USDC on Solana, Base, Arbitrum, Polygon, Arc, Soneium), and swaps on Robinhood Chain and Base. CLI, SDK and MCP server.",
  "type": "module",
  "bin": {
    "wafermap": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test"
  },
  "keywords": [
    "x402",
    "agents",
    "mcp",
    "wallet",
    "robinhood-chain",
    "base",
    "arbitrum",
    "polygon",
    "arc",
    "soneium",
    "solana",
    "usdg",
    "usdc"
  ],
  "homepage": "https://wafermap.xyz/docs#cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wafermap/wafermap-cli.git"
  },
  "bugs": {
    "url": "https://github.com/wafermap/wafermap-cli/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6",
    "viem": "^2.56.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
